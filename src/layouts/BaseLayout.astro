---
// Navbar matches the reference implementation exactly
// (~/Downloads/amwayi-site/index.html vs article.html): the homepage gets
// Philosophy/Writing/Projects/Now anchors and a phone dropdown; inner
// pages (articles, projects, listings) get a simpler Home/Articles/Projects
// nav, no phone dropdown, and a mobile-only "back" link in place of the
// logo. variant picks which one renders.
import '../styles/tailwind.css';
import '../styles/global.css';
import { withBase } from '../lib/url';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  variant?: 'home' | 'inner';
  simpleFooter?: boolean;
  backHref?: string;
  backLabel?: string;
}
const { title, variant = 'home', simpleFooter = false, backHref, backLabel } = Astro.props;

const home = withBase('/');
const homeNav = [
  { id: 'philosophy', label: 'Philosophy' },
  { id: 'writing', label: 'Writing' },
  { id: 'projects', label: 'Projects' },
  { id: 'now', label: 'Now' },
];
const innerNav = [
  { href: home, label: 'Home' },
  { href: `${home}#writing`, label: 'Articles' },
  { href: `${home}#projects`, label: 'Projects' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=Karla:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Applies the saved (or system) theme before first paint, so there's
      // no flash.
      (function () {
        var t = localStorage.getItem('theme');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'nightwatch' : 'pasture';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body class="bg-base-100 text-base-content font-sans antialiased">
    <header class="sticky top-0 z-30 border-b border-base-300 bg-base-100/95 backdrop-blur">
      <div class="navbar mx-auto min-h-[72px] max-w-[1440px] px-5 md:px-24">
        <div class="navbar-start">
          {variant === 'home' ? (
            <a href={home} class="flex items-center gap-3 font-display text-[22px] font-semibold md:text-[26px]">
              <svg class="size-6 md:size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M9 22V9a4 4 0 1 1 8 0v1" />
              </svg>
              Amwayi
            </a>
          ) : (
            <>
              <a href={`${home}#writing`} class="flex min-h-11 items-center gap-2 font-bold md:hidden">
                <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 5l-7 7 7 7" />
                </svg>
                Articles
              </a>
              <a href={home} class="hidden items-center gap-3 font-display text-[26px] font-semibold md:flex">
                <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <path d="M9 22V9a4 4 0 1 1 8 0v1" />
                </svg>
                Amwayi
              </a>
            </>
          )}
        </div>
        {variant === 'inner' && (
          <div class="navbar-center font-display text-xl font-semibold md:hidden">Amwayi</div>
        )}
        <div class="navbar-end gap-2 md:gap-8">
          {variant === 'home' ? (
            <nav aria-label="Main" class="hidden gap-9 text-base font-medium md:flex">
              {homeNav.map((item) => (
                <a href={`${home}#${item.id}`} class="py-3 hover:text-primary">{item.label}</a>
              ))}
            </nav>
          ) : (
            <nav aria-label="Main" class="hidden gap-9 text-base font-medium md:flex">
              {innerNav.map((item) => (
                <a href={item.href} class="py-3 hover:text-primary">{item.label}</a>
              ))}
            </nav>
          )}

          <button
            type="button"
            class="btn btn-circle btn-outline border-base-300 bg-base-200"
            data-theme-toggle
            aria-label="Switch theme"
          >
            <svg class="theme-icon-moon size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
            </svg>
            <svg class="theme-icon-sun hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>

          {variant === 'home' && (
            <details class="dropdown dropdown-end md:hidden" data-mobile-menu>
              <summary class="btn btn-circle btn-outline border-base-300 bg-base-200" aria-label="Open menu">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
              </summary>
              <ul class="menu dropdown-content z-40 mt-3 w-[calc(100vw-2rem)] rounded-box border border-base-300 bg-base-200 p-2 text-lg font-bold shadow-xl">
                {homeNav.map((item) => (
                  <li><a href={`${home}#${item.id}`} class="min-h-[52px]">{item.label}</a></li>
                ))}
              </ul>
            </details>
          )}
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <Footer simple={simpleFooter} backHref={backHref} backLabel={backLabel} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function syncThemeIcons() {
          var dark = root.getAttribute('data-theme') === 'nightwatch';
          document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
            btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
            btn.querySelector('.theme-icon-moon').classList.toggle('hidden', dark);
            btn.querySelector('.theme-icon-sun').classList.toggle('hidden', !dark);
          });
        }
        document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'nightwatch' ? 'pasture' : 'nightwatch';
            root.setAttribute('data-theme', next);
            try {
              localStorage.setItem('theme', next);
            } catch {}
            syncThemeIcons();
          });
        });
        syncThemeIcons();

        document.querySelectorAll('[data-mobile-menu]').forEach(function (menu) {
          menu.addEventListener('click', function (e) {
            if (e.target.closest('a')) menu.removeAttribute('open');
          });
          document.addEventListener('click', function (e) {
            if (!menu.contains(e.target)) menu.removeAttribute('open');
          });
        });
      })();
    </script>
  </body>
</html>
