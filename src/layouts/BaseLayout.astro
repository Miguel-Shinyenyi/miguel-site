---
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title: string;
}
const { title } = Astro.props;

const nav = [
  { href: '/philosophy', label: 'philosophy' },
  { href: '/tech', label: 'tech' },
  { href: '/journal', label: 'journal' },
  { href: '/projects', label: 'projects' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a href={withBase('/')} class="site-title">miguel</a>
      <nav class="site-nav">
        {nav.map((item) => (
          <a href={withBase(item.href)}>/{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>observe, name, investigate, record, learn, govern.</p>
    </footer>
  </body>
</html>
