---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Journal">
  <h1>Journal</h1>
  <ul class="entry-list">
    {entries.map((entry) => (
      <li>
        <span class="entry-date">{entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        <a href={`/journal/${entry.slug}`}>{entry.data.title}</a>
        <p class="entry-summary">{entry.data.summary}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
