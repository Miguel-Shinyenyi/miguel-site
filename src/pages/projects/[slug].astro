---
// Projects render through the same shared article template as
// philosophy/tech/journal, per the brief: the old slim template here is
// gone (it also rendered an empty "Comments" heading from Giscus above
// "Guest comments", which ArticlePage.astro's isProject branch skips by
// only rendering Waline for projects).
import ArticlePage from '../../components/ArticlePage.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---
<ArticlePage entry={entry} section="projects" sectionLabel="Projects" />
