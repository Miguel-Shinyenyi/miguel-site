---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Projects — Amwayi" simpleFooter variant="inner">
  <div class="mx-auto max-w-5xl px-5 py-16 md:px-24 md:py-28">
    <span class="text-sm font-bold uppercase tracking-[0.14em] text-primary">Built, not just planned</span>
    <h1 class="font-display text-[34px] md:text-[52px]">Projects</h1>
    <div class="mt-8 grid gap-3 md:grid-cols-2 md:gap-6">
      {entries.map((entry) => (
        <ProjectCard
          title={entry.data.title}
          summary={entry.data.summary}
          status={entry.data.status}
          statusVariant={entry.data.statusVariant}
          category={entry.data.category}
          stack={entry.data.stack}
          link={entry.data.link}
          linkLabel={entry.data.linkLabel}
        />
      ))}
    </div>
  </div>
</BaseLayout>
