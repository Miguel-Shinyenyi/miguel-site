---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<BaseLayout
  title="Projects — Amwayi"
  description="Things I have built, and what each one taught me."
>
  <section class="mx-auto max-w-[1280px] px-5 py-14 md:px-10 md:py-20">
    <div class="flex max-w-[60ch] flex-col gap-3" data-reveal>
      <h1 class="text-[38px] font-bold leading-[1.05] tracking-[-0.03em] md:text-[56px]">Projects</h1>
      <p class="text-lg text-muted">Built, not just planned. {entries.length} in total.</p>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {entries.map((entry, i) => (
        <ProjectCard
          title={entry.data.title}
          summary={entry.data.summary}
          status={entry.data.status}
          statusVariant={entry.data.statusVariant}
          category={entry.data.category}
          stack={entry.data.stack}
          link={entry.data.link}
          linkLabel={entry.data.linkLabel}
          tint={i === 0}
        />
      ))}
    </div>
  </section>
</BaseLayout>
