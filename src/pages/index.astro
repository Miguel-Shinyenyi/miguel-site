---
import BaseLayout from '../layouts/BaseLayout.astro';
import Shepherd from '../components/Shepherd.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { withBase } from '../lib/url';
import { getCollection } from 'astro:content';
import { getOpenThreads } from '../lib/openThreads';

const philosophyEntries = (await getCollection('philosophy', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const techEntries = (await getCollection('tech', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const journalEntries = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projectEntries = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const [nowEntry] = await getCollection('now');

const threads = await getOpenThreads();
const asOf = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const pillars = [
  {
    n: '01',
    title: 'Myself',
    body: 'I journal daily. Writing shows me my habits, my choices and the reasons behind them.',
    practice: 'A daily entry. What I did, what I felt, what I learned.',
  },
  {
    n: '02',
    title: 'My tools',
    body: 'I study the technology that shapes my work: backend systems, data and AI. I learn it by building it.',
    practice: "Build it, break it, then write down why it broke.",
  },
  {
    n: '03',
    title: 'People and the world',
    body: 'I read history and philosophy to see why people think and act as they do. I aim to understand, not to judge.',
    practice: 'Read one idea, then ask who it helps and who it leaves out.',
  },
  {
    n: '04',
    title: 'Putting it to use',
    body: "Knowledge counts when it changes what I do. I turn lessons into routines, projects and goals.",
    practice: "Every lesson ends with one change to tomorrow's routine.",
  },
];

const writingTabs = [
  { id: 'philosophy', label: 'Philosophy', blurb: 'Articles on how to think and live.', entries: philosophyEntries, italic: false },
  { id: 'tech', label: 'Tech', blurb: 'Notes on backend systems, data and AI.', entries: techEntries, italic: false },
  { id: 'journal', label: 'Journal', blurb: 'Short, edited excerpts from daily entries.', entries: journalEntries, italic: true },
];

const readTimeFor = (body: string) => Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 215));
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const nowRows = nowEntry
  ? [
      { label: 'Working', value: nowEntry.data.working },
      { label: 'Reading', value: nowEntry.data.reading },
      { label: 'Building', value: nowEntry.data.building },
      { label: 'Based in', value: nowEntry.data.basedIn },
    ]
  : [];
---
<BaseLayout title="Amwayi">
  <!-- Hero (4.2) -->
  <section class="px-5 py-16 md:px-24 md:py-28">
    <div class="grid items-center gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <span class="text-sm font-bold uppercase tracking-[0.14em] text-primary">Amwayi means shepherd</span>
        <h1 class="mt-3 font-display text-[44px] leading-none tracking-tight md:text-[76px]">
          Understanding, tended daily.
        </h1>
        <p class="mt-6 max-w-prose text-lg leading-relaxed text-base-content/80">
          I journal to understand myself, study to understand technology, read to understand people, and build to
          put it all to use. The journal is the hub. Everything else is a spoke.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={withBase('/journal')} class="btn btn-neutral w-full rounded-full sm:w-auto">Read the journal</a>
          <a href={`${withBase('/')}#projects`} class="btn btn-outline w-full rounded-full sm:w-auto">See the projects</a>
        </div>
      </div>

      <div class="relative mx-auto aspect-[600/560] w-full max-w-[600px]">
        <Shepherd />
        <button
          id="thought"
          type="button"
          class="absolute left-[3%] top-[4%] w-[62%] rounded-[32px] border-2 border-neutral bg-white px-5 py-4 text-left text-neutral md:w-[56%] md:rounded-[64px] md:px-8 md:py-6"
          aria-live="polite"
        >
          <span id="thought-text" class="font-display text-base italic leading-tight md:text-2xl">
            Who shepherds the shepherd?
          </span>
          <span class="mt-2 block text-xs font-bold text-[#5B615B] md:text-sm">Tap for another thought</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Four things I try to understand (4.3) -->
  <section id="philosophy" class="bg-base-200 px-5 py-16 md:px-24 md:py-28">
    <span class="text-sm font-bold uppercase tracking-[0.14em] text-primary">Philosophy</span>
    <h2 class="mt-2 font-display text-[34px] md:text-[52px]">Four things I try to understand</h2>
    <div class="mt-10 grid gap-3 md:grid-cols-4 md:gap-6">
      {pillars.map((p, i) => (
        <div class="collapse rounded-box bg-base-100 has-[:checked]:bg-neutral has-[:checked]:text-neutral-content">
          <input type="radio" name="pillar" checked={i === 0} aria-label={p.title} />
          <div class="collapse-title">
            <span class="font-display text-4xl text-primary">{p.n}</span>
            <h3 class="font-display text-2xl font-semibold">{p.title}</h3>
            <p class="opacity-80">{p.body}</p>
          </div>
          <div class="collapse-content">
            <p class="font-display text-xl">In practice: {p.practice}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- How it fits together (4.4) -->
  <section id="hub-section" class="bg-neutral px-5 py-16 text-neutral-content md:px-24 md:py-28">
    <span class="text-sm font-bold uppercase tracking-[0.14em] text-accent">How it fits together</span>
    <h2 class="mt-2 font-display text-[34px] md:text-[52px]">The journal is the hub</h2>

    <ul class="steps steps-horizontal mt-10 w-full">
      <li class="step step-accent">Observe</li>
      <li class="step step-accent">Write</li>
      <li class="step step-accent">Connect</li>
      <li class="step step-accent">Apply</li>
    </ul>

    <div class="mt-12 grid gap-10 md:grid-cols-2 md:items-center">
      <svg viewBox="0 0 520 320" class="w-full" role="img" aria-label="A diagram of the journal at the center, connected by four spokes to philosophy, tech, people, and projects.">
        <line x1="260" y1="160" x2="100" y2="70" stroke="currentColor" stroke-opacity="0.35" stroke-width="2" />
        <line x1="260" y1="160" x2="420" y2="70" stroke="currentColor" stroke-opacity="0.35" stroke-width="2" />
        <line x1="260" y1="160" x2="100" y2="250" stroke="currentColor" stroke-opacity="0.35" stroke-width="2" />
        <line x1="260" y1="160" x2="420" y2="250" stroke="currentColor" stroke-opacity="0.35" stroke-width="2" />

        <g id="node-philosophy"><circle cx="100" cy="70" r="34" fill="var(--color-base-100)" /><text x="100" y="75" text-anchor="middle" font-size="13" fill="var(--color-base-content)">Philosophy</text></g>
        <g id="node-tech"><circle cx="420" cy="70" r="34" fill="var(--color-base-100)" /><text x="420" y="75" text-anchor="middle" font-size="13" fill="var(--color-base-content)">Tech</text></g>
        <g id="node-people"><circle cx="100" cy="250" r="34" fill="var(--color-base-100)" /><text x="100" y="255" text-anchor="middle" font-size="13" fill="var(--color-base-content)">People</text></g>
        <g id="node-projects"><circle cx="420" cy="250" r="34" fill="var(--color-base-100)" /><text x="420" y="255" text-anchor="middle" font-size="13" fill="var(--color-base-content)">Projects</text></g>
        <g id="node-journal"><circle cx="260" cy="160" r="46" fill="var(--color-primary)" /><text x="260" y="166" text-anchor="middle" font-size="15" font-weight="700" fill="var(--color-primary-content)">Journal</text></g>
      </svg>

      <div role="tablist" class="tabs tabs-box gap-2 bg-transparent" id="hub">
        <input type="radio" name="hub" class="tab rounded-full" aria-label="Journal" checked />
        <div class="tab-content pt-6 font-display text-xl">The source of truth. Every day starts or ends here.</div>
        <input type="radio" name="hub" class="tab rounded-full" aria-label="Philosophy" />
        <div class="tab-content pt-6 font-display text-xl">Questions from the journal become articles on how to think and live.</div>
        <input type="radio" name="hub" class="tab rounded-full" aria-label="Tech" />
        <div class="tab-content pt-6 font-display text-xl">Problems I hit at work become notes on systems, data and AI.</div>
        <input type="radio" name="hub" class="tab rounded-full" aria-label="People" />
        <div class="tab-content pt-6 font-display text-xl">Conversations and reading become notes on how others see the world.</div>
        <input type="radio" name="hub" class="tab rounded-full" aria-label="Projects" />
        <div class="tab-content pt-6 font-display text-xl">Lessons become code, routines and tools I use every day.</div>
      </div>
    </div>

    {threads.length > 0 && (
      <div class="mt-16 border-t border-neutral-content/20 pt-10">
        <h3 class="font-display text-2xl font-semibold">Open threads</h3>
        <ul class="mt-6 flex flex-col gap-5">
          {threads.map((thread) => (
            <li>
              <span class="block text-xs font-bold uppercase tracking-[0.1em] text-accent">{thread.project}</span>
              <span class="block">{thread.text}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-neutral-content/70">Pulled from the UMWAYI hub at build time, as of {asOf}.</p>
      </div>
    )}
  </section>

  <!-- Writing (4.5) -->
  <section id="writing" class="px-5 py-16 md:px-24 md:py-28">
    <span class="text-sm font-bold uppercase tracking-[0.14em] text-primary">Writing</span>
    <h2 class="mt-2 font-display text-[34px] md:text-[52px]">Latest entries</h2>

    <div role="tablist" class="tabs tabs-box mt-10 w-full rounded-full md:w-auto">
      {writingTabs.map((tab, i) => (
        <>
          <input type="radio" name="writing" class="tab rounded-full" aria-label={tab.label} checked={i === 0} />
          <div class="tab-content pt-6">
            <p class="mb-4 text-base-content/80">{tab.blurb}</p>
            {tab.entries.length > 0 ? (
              <ul class="list">
                {tab.entries.map((entry) => (
                  <li class="list-row">
                    <a
                      href={withBase(`/${tab.id}/${entry.slug}`)}
                      class:list={['font-display text-2xl text-base-content no-underline hover:text-primary', { italic: tab.italic }]}
                    >
                      {entry.data.title}
                    </a>
                    <span class="text-sm opacity-70">{fmt(entry.data.date)} · {readTimeFor(entry.body)} min</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-base-content/60">Nothing published here yet.</p>
            )}
            <a href={withBase(`/${tab.id}`)} class="link link-primary mt-4 inline-block font-bold">
              See all {tab.label.toLowerCase()} →
            </a>
          </div>
        </>
      ))}
    </div>
  </section>

  <!-- Projects (4.6) -->
  <section id="projects" class="bg-base-200 px-5 py-16 md:px-24 md:py-28">
    <span class="text-sm font-bold uppercase tracking-[0.14em] text-primary">Built, not just planned</span>
    <h2 class="mt-2 font-display text-[34px] md:text-[52px]">Projects</h2>
    <div class="mt-10 grid gap-3 md:grid-cols-2 md:gap-6">
      {projectEntries.map((entry) => (
        <ProjectCard
          title={entry.data.title}
          summary={entry.data.summary}
          status={entry.data.status}
          statusVariant={entry.data.statusVariant}
          category={entry.data.category}
          stack={entry.data.stack}
          link={entry.data.link}
          linkLabel={entry.data.linkLabel}
        />
      ))}
    </div>
  </section>

  <!-- Now (4.7) -->
  {nowEntry && (
    <section id="now" class="px-5 py-16 md:px-24 md:py-28">
      <span class="text-sm font-bold uppercase tracking-[0.14em] text-primary">Now</span>
      <h2 class="mt-2 font-display text-[34px] md:text-[52px]">What I'm doing</h2>
      <dl class="mt-10 grid gap-x-10 gap-y-6 md:grid-cols-2">
        {nowRows.map((row) => (
          <div class="border-b border-base-300 pb-4">
            <dt class="text-sm font-bold uppercase tracking-[0.1em] text-primary">{row.label}</dt>
            <dd class="mt-1 text-lg">{row.value}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-6 text-sm text-base-content/60">
        Updated {nowEntry.data.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}.
      </p>
    </section>
  )}

  <script src="../scripts/thoughts.js"></script>
</BaseLayout>
