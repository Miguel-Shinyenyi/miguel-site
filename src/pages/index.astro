---
// Homepage, ported from the 2026-09-29 reference
// ("~/Downloads/amwayi-site 2", index.html): markup, classes and copy are
// the reference's; the entries, projects and "now" values are this site's
// real content from UMWAYI, not the reference's sample text.
import BaseLayout from '../layouts/BaseLayout.astro';
import Shepherd from '../components/Shepherd.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { withBase, resolveLink } from '../lib/url';
import { getCollection } from 'astro:content';
import { getOpenThreads } from '../lib/openThreads';
import { PILLAR_STICKERS } from '../lib/pillarStickers';

// Newest first, kept whole: the tabs show the three newest, and each tab
// also links to its section index carrying the real total.
const byNewest = <T extends { data: { date: Date } }>(entries: T[]) =>
  [...entries].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allPhilosophy = byNewest(await getCollection('philosophy', ({ data }) => !data.draft));
const allTech = byNewest(await getCollection('tech', ({ data }) => !data.draft));
const allJournal = byNewest(await getCollection('journal', ({ data }) => !data.draft));

const projectEntries = byNewest(await getCollection('projects', ({ data }) => !data.draft));
// The bento needs one featured project spanning two columns and two rows.
// Settlement Engine is the deepest of the four and the one the reference
// features; the rest fill the remaining cells, no empty ones.
const featured =
  projectEntries.find((entry) => entry.slug === 'settlement-engine') ?? projectEntries[0];
const otherProjects = projectEntries.filter((entry) => entry !== featured);

const [nowEntry] = await getCollection('now');
const [linksEntry] = await getCollection('links');
const hashnodeUrl = linksEntry.data.links.find((l) => l.label === 'Hashnode')?.url ?? '#';

const threads = await getOpenThreads();

const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const readTimeFor = (body: string) =>
  Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 215));

const pillars = [
  {
    value: '1',
    title: 'Myself',
    body: 'I journal daily. Writing shows me my habits, my choices and the reasons behind them.',
    practice: 'A daily entry. What I did, what I felt, what I learned.',
  },
  {
    value: '2',
    title: 'My tools',
    body: 'I study the technology that shapes my work: backend systems, data and AI. I learn it by building it.',
    practice: 'Build it, break it, then write down why it broke.',
  },
  {
    value: '3',
    title: 'People and the world',
    body: 'I read history and philosophy to see why people think and act as they do. I aim to understand, not to judge.',
    practice: 'Read one idea, then ask who it helps and who it leaves out.',
  },
  {
    value: '4',
    title: 'Putting it to use',
    body: 'Knowledge counts when it changes what I do. I turn lessons into routines, projects and goals.',
    practice: "Every lesson ends with one change to tomorrow's routine.",
  },
];

const hubNodes = [
  { value: 'journal', label: 'Journal', line: 'The source of truth. Every day starts or ends here.' },
  { value: 'philosophy', label: 'Philosophy', line: 'Questions from the journal become articles on how to think and live.' },
  { value: 'tech', label: 'Tech', line: 'Problems I hit at work become articles on systems, data and AI.' },
  { value: 'people', label: 'People', line: 'Conversations and reading become notes on how others see the world.' },
  { value: 'projects', label: 'Projects', line: 'Lessons become code, routines and tools I use every day.' },
];

const writingTabs = [
  {
    id: 'philosophy',
    label: 'Philosophy',
    blurb: 'Articles on how to think and live.',
    entries: allPhilosophy.slice(0, 3),
    allLabel: `All philosophy articles (${allPhilosophy.length})`,
  },
  {
    id: 'tech',
    label: 'Tech',
    blurb: 'Articles on backend systems, data and AI.',
    entries: allTech.slice(0, 3),
    allLabel: `All tech articles (${allTech.length})`,
  },
  {
    id: 'journal',
    label: 'Journal',
    blurb: 'Articles drawn from my daily entries.',
    entries: allJournal.slice(0, 3),
    allLabel: `All journal entries (${allJournal.length})`,
  },
];
---
<BaseLayout title="Amwayi · Philosophy, tech and journaling">
  <!-- ============ HERO ============ -->
  <section
    id="top"
    class="mx-auto grid max-w-[1280px] items-center gap-10 px-5 pb-16 pt-10 md:grid-cols-[1fr_1.05fr] md:gap-14 md:px-10 md:pb-24 md:pt-16"
  >
    <div class="flex flex-col gap-6">
      <p class="eyebrow" data-reveal style="--i:0">Umwayi means shepherd</p>
      <h1 class="text-[44px] font-bold leading-[1.02] tracking-[-0.035em] md:text-[62px]" data-reveal style="--i:1">
        I tend what I learn and put it to&nbsp;work.
      </h1>
      <p class="max-w-[34ch] text-lg leading-relaxed text-muted md:text-xl" data-reveal style="--i:2">
        Backend engineer in Nairobi. I write about philosophy, tech and journaling, and use what I
        learn to reach my goals.
      </p>
      <div class="flex flex-col gap-3 pt-2 sm:flex-row" data-reveal style="--i:3">
        <a href="#writing" class="btn-cta">Read the articles</a>
        <a href="#projects" class="btn-quiet">See the projects</a>
      </div>
    </div>

    <div
      class="hero-art relative aspect-[600/560] w-full max-w-[600px] md:justify-self-end"
      data-reveal
      style="--i:2"
    >
      <Shepherd />
      <button
        type="button"
        id="thought"
        class="bubble absolute left-[2%] top-[3%] flex w-[58%] cursor-pointer flex-col gap-2 rounded-[40px] border-2 border-[#1E2520] bg-[#FBFBF7] px-[6%] py-[4%] text-left text-[#1E2520] md:rounded-[56px]"
        aria-label="The shepherd is thinking. Show another thought."
      >
        <span
          class="thought-text font-display text-[17px] font-semibold leading-tight tracking-[-0.01em] sm:text-xl md:text-2xl"
          id="thought-text"
          aria-live="polite"
        >
          Who shepherds the shepherd?
        </span>
        <span class="flex items-center gap-1.5 text-xs font-medium text-[#5A6057] md:text-[13px]">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" />
            <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" />
          </svg>
          Tap for another thought
        </span>
      </button>
    </div>
  </section>

  <!-- ============ PILLARS ============ -->
  <section id="pillars" class="border-t border-hairline">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-8 px-5 py-16 md:gap-10 md:px-10 md:py-24">
      <div class="flex max-w-[60ch] flex-col gap-3" data-reveal>
        <h2 class="text-[34px] font-bold leading-[1.05] tracking-[-0.03em] md:text-[48px]">
          Four things I try to understand
        </h2>
        <p class="text-lg text-muted">Each one feeds the next. Pick one to see how I practice it.</p>
      </div>

      <fieldset class="grid gap-3 sm:grid-cols-2 md:gap-4 lg:grid-cols-4" data-reveal style="--i:1">
        <legend class="sr-only">Pick a pillar</legend>
        {pillars.map((pillar, i) => (
          <label class="pillar">
            <input type="radio" name="pillar" value={pillar.value} class="sr-only" checked={i === 0} />
            <span class="sticker" aria-hidden="true" set:html={PILLAR_STICKERS[i]} />
            <span class="font-display text-[22px] font-bold tracking-[-0.02em]">{pillar.title}</span>
            <span class="pillar-body text-[15px] leading-relaxed text-muted">{pillar.body}</span>
          </label>
        ))}
      </fieldset>

      <div
        class="flex flex-col gap-2 rounded-box bg-[var(--amber-tint)] px-5 py-4 sm:flex-row sm:items-center sm:gap-5 md:px-6"
        data-reveal
        style="--i:2"
      >
        <span class="shrink-0 text-[13px] font-semibold uppercase tracking-[0.12em]">In practice</span>
        <div
          class="practice-stack font-display text-lg font-medium leading-snug tracking-[-0.01em] md:text-[21px]"
          role="status"
        >
          {pillars.map((pillar, i) => (
            <p class:list={['practice', `practice-${i + 1}`]}>{pillar.practice}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HUB ============ -->
  <section id="hub" class="border-y border-hairline bg-base-200">
    <div class="mx-auto grid max-w-[1280px] items-center gap-10 px-5 py-16 md:grid-cols-2 md:gap-16 md:px-10 md:py-24">
      <div class="order-2 flex justify-center md:order-1" data-reveal style="--i:1">
        <svg
          class="h-auto w-full max-w-[460px]"
          viewBox="0 0 480 460"
          fill="none"
          role="img"
          aria-label="Journal at the center, connected to philosophy, tech, people and projects"
        >
          <circle cx="240" cy="230" r="160" stroke="var(--hairline)" stroke-dasharray="3 8" />
          <line class="spoke spoke-philosophy" x1="240" y1="230" x2="240" y2="70" />
          <line class="spoke spoke-tech" x1="240" y1="230" x2="400" y2="230" />
          <line class="spoke spoke-projects" x1="240" y1="230" x2="240" y2="390" />
          <line class="spoke spoke-people" x1="240" y1="230" x2="80" y2="230" />
          <g class="hub-node node-journal">
            <circle cx="240" cy="230" r="66" />
            <text x="240" y="237" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-size="21" font-weight="700">Journal</text>
          </g>
          <g class="hub-node node-philosophy">
            <circle cx="240" cy="70" r="50" />
            <text x="240" y="76" text-anchor="middle" font-family="Geist, sans-serif" font-size="15" font-weight="600">Philosophy</text>
          </g>
          <g class="hub-node node-tech">
            <circle cx="400" cy="230" r="50" />
            <text x="400" y="236" text-anchor="middle" font-family="Geist, sans-serif" font-size="15" font-weight="600">Tech</text>
          </g>
          <g class="hub-node node-projects">
            <circle cx="240" cy="390" r="50" />
            <text x="240" y="396" text-anchor="middle" font-family="Geist, sans-serif" font-size="15" font-weight="600">Projects</text>
          </g>
          <g class="hub-node node-people">
            <circle cx="80" cy="230" r="50" />
            <text x="80" y="236" text-anchor="middle" font-family="Geist, sans-serif" font-size="15" font-weight="600">People</text>
          </g>
        </svg>
      </div>

      <div class="order-1 flex flex-col gap-6 md:order-2" data-reveal>
        <h2 class="text-[34px] font-bold leading-[1.05] tracking-[-0.03em] md:text-[48px]">
          The journal sits at the center.
        </h2>
        <p class="max-w-[46ch] text-lg text-muted">
          Every entry feeds the rest. An idea becomes an article. A lesson becomes a habit. A problem
          becomes a project.
        </p>

        <ol class="flex flex-wrap items-center gap-2 text-[15px] font-semibold" aria-label="How an entry moves">
          {['Observe', 'Write', 'Connect', 'Apply'].map((step, i) => (
            <>
              <li class="chip bg-card">{step}</li>
              {i < 3 && (
                <li aria-hidden="true" class="text-soft">
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12l14 0" />
                    <path d="M13 18l6 -6" />
                    <path d="M13 6l6 6" />
                  </svg>
                </li>
              )}
            </>
          ))}
        </ol>

        <div role="radiogroup" aria-label="Explore the hub" class="flex flex-wrap gap-2">
          {hubNodes.map((node, i) => (
            <label class="pill-tab inline-flex items-center bg-card">
              <input type="radio" name="hub" value={node.value} class="sr-only" checked={i === 0} />
              {node.label}
            </label>
          ))}
        </div>
        <div
          class="practice-stack min-h-[3.2em] font-display text-lg font-medium leading-snug md:text-xl"
          role="status"
          id="hub-text"
        >
          {hubNodes.map((node) => (
            <p class:list={['practice', `hub-${node.value}`]}>{node.line}</p>
          ))}
        </div>

        <!-- Open threads: this site's own feature, pulled from UMWAYI at
             build time. The reference has no equivalent. -->
        {threads.length > 0 && (
          <div class="flex flex-col gap-3 border-t border-hairline pt-6">
            <h3 class="font-display text-lg font-bold tracking-[-0.01em]">Open threads</h3>
            <ul class="flex flex-col gap-3">
              {threads.map((thread) => (
                <li class="flex flex-col gap-1">
                  <span class="font-mono text-[13px] uppercase tracking-[0.08em] text-soft">{thread.project}</span>
                  <span class="text-[15px] leading-relaxed text-muted">{thread.text}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ============ ARTICLES ============ -->
  <section id="writing" class="mx-auto flex max-w-[1280px] flex-col gap-8 px-5 py-16 md:px-10 md:py-24">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
      <div class="flex flex-col gap-3">
        <p class="eyebrow">Writing</p>
        <h2 class="text-[34px] font-bold leading-[1.05] tracking-[-0.03em] md:text-[48px]">
          Recent articles
        </h2>
      </div>
      <a
        href={resolveLink(hashnodeUrl)}
        target="_blank"
        rel="noopener"
        class="link-amber inline-flex items-center gap-1.5 self-start py-2 text-[15px] md:self-auto"
      >
        All articles on Hashnode
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 7l-10 10" />
          <path d="M8 7l9 0l0 9" />
        </svg>
      </a>
    </div>

    <div role="tablist" aria-label="Article topics" class="tabs gap-2" data-reveal style="--i:1">
      {writingTabs.map((tab, i) => (
        <>
          <input
            type="radio"
            name="writing"
            role="tab"
            class="tab pill-tab flex-1 bg-card sm:flex-none"
            aria-label={tab.label}
            checked={i === 0}
          />
          <div role="tabpanel" class="tab-content order-last w-full basis-full">
            <p class="py-5 text-muted">{tab.blurb}</p>
            <ul class="border-b border-hairline">
              {tab.entries.length > 0 ? (
                tab.entries.map((entry) => (
                  <li>
                    <a
                      href={withBase(`/${tab.id}/${entry.slug}`)}
                      class="row-link flex items-start justify-between gap-4 border-t border-hairline py-5 sm:items-baseline"
                    >
                      <span class="flex grow flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-6">
                        <span class="grow font-display text-xl font-semibold leading-snug tracking-[-0.015em] md:text-2xl">
                          {entry.data.title}
                        </span>
                        <span class="shrink-0 font-mono text-sm text-soft">
                          {fmt(entry.data.date)} · {readTimeFor(entry.body)} min
                        </span>
                      </span>
                      <svg class="row-arrow size-5 shrink-0 text-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12l14 0" />
                        <path d="M13 18l6 -6" />
                        <path d="M13 6l6 6" />
                      </svg>
                    </a>
                  </li>
                ))
              ) : (
                <li class="border-t border-hairline py-5 text-muted">Nothing published here yet.</li>
              )}
            </ul>
            <a href={withBase(`/${tab.id}`)} class="link-amber inline-flex items-center gap-1.5 py-3 text-[15px]">
              {tab.allLabel}
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12l14 0" />
                <path d="M13 18l6 -6" />
                <path d="M13 6l6 6" />
              </svg>
            </a>
          </div>
        </>
      ))}
    </div>
  </section>

  <!-- ============ PROJECTS: bento, exactly as many cells as projects ============ -->
  <section id="projects" class="border-t border-hairline">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-8 px-5 py-16 md:gap-10 md:px-10 md:py-24">
      <h2 class="text-[34px] font-bold leading-[1.05] tracking-[-0.03em] md:text-[48px]" data-reveal>
        What I'm building
      </h2>

      <div class="grid gap-4 lg:grid-cols-3 lg:grid-rows-3">
        <a
          href={withBase(`/projects/${featured.slug}`)}
          class="tile group overflow-hidden bg-card lg:col-span-2 lg:row-span-2"
          data-reveal
          style="--i:1"
        >
          {featured.data.illustration && (
            <div class="border-b border-hairline bg-base-200">
              <img
                src={withBase(`/illustrations/${featured.data.illustration}`)}
                alt={featured.data.illustrationAlt ?? ''}
                class="block h-auto w-full"
                loading="lazy"
              />
            </div>
          )}
          <div class="flex grow flex-col gap-3 p-6 md:p-7">
            <div class="flex items-center justify-between gap-2">
              <span
                class:list={[
                  'chip font-semibold',
                  featured.data.statusVariant === 'success'
                    ? 'border-success text-success'
                    : 'border-[var(--field-edge)]',
                ]}
              >
                {featured.data.status}
              </span>
              <span class="text-sm text-soft">{featured.data.category}</span>
            </div>
            <h3 class="text-2xl font-bold tracking-[-0.02em] md:text-[34px]">{featured.data.title}</h3>
            <p class="text-[15px] leading-relaxed text-muted md:text-base">{featured.data.summary}</p>
            <p class="mt-auto text-sm text-soft">{featured.data.stack.join(', ')}</p>
            <span class="link-amber inline-flex items-center gap-1.5 self-start">
              {featured.data.linkLabel}
              <span class="transition-transform duration-150 group-hover:translate-x-1">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12l14 0" />
                  <path d="M13 18l6 -6" />
                  <path d="M13 6l6 6" />
                </svg>
              </span>
            </span>
          </div>
        </a>

        {otherProjects.map((entry, i) => (
          <ProjectCard
            title={entry.data.title}
            summary={entry.data.summary}
            status={entry.data.status}
            statusVariant={entry.data.statusVariant}
            category={entry.data.category}
            stack={entry.data.stack}
            link={entry.data.link}
            linkLabel={entry.data.linkLabel}
            tint={i === 0}
            class={i === 2 ? 'lg:col-span-3' : ''}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ NOW ============ -->
  <section id="now" class="border-y border-hairline bg-base-200">
    <div class="mx-auto grid max-w-[1280px] gap-6 px-5 py-16 md:grid-cols-12 md:gap-8 md:px-10 md:py-20">
      <div class="flex flex-col gap-3 md:col-span-4" data-reveal>
        <h2 class="text-[34px] font-bold leading-[1.05] tracking-[-0.03em] md:text-[40px]">Now</h2>
        <p class="text-muted">
          Updated {nowEntry.data.updated.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}.
        </p>
      </div>
      <dl class="grid gap-x-10 gap-y-6 sm:grid-cols-2 md:col-span-8" data-reveal style="--i:1">
        {[
          ['Working', nowEntry.data.working],
          ['Reading', nowEntry.data.reading],
          ['Building', nowEntry.data.building],
          ['Based in', nowEntry.data.basedIn],
        ].map(([label, value]) => (
          <div class="flex flex-col gap-1">
            <dt class="text-sm font-semibold text-soft">{label}</dt>
            <dd class="text-lg leading-snug">{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <script src="../scripts/thoughts.js"></script>
</BaseLayout>
