---
// The shepherd mascot (docs/design.md, Mascot section, revised 2026-09-22).
// The staff is a literal <text> render of the same "|" character used by
// the site's cursor-blink glyph elsewhere, not a separate crook icon. The
// six flock marks (Observe, Name, Investigate, Record, Learn, Govern) are
// one repeated <symbol>, not six bespoke illustrations, kept simple enough
// to read as a group at a glance. Gather animation is wired up by
// src/scripts/flock-gather.js; this component only renders the markup.
---
<div class="mascot" aria-hidden="true">
  <svg viewBox="0 0 220 220" class="mascot-figure" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <symbol id="flock-mark" viewBox="0 0 20 20">
        <path d="M10,1 C15,7 17,11 17,14 A7,7 0 1 1 3,14 C3,11 5,7 10,1 Z" />
      </symbol>
    </defs>

    <!-- shepherd: robe, arm, head, one eye, staff -->
    <path class="mascot-robe" d="M52,66 L92,66 L106,198 L38,198 Z" />
    <path class="mascot-arm" d="M86,82 L116,71 L120,81 L92,94 Z" />
    <circle class="mascot-head" cx="72" cy="46" r="20" />
    <circle class="mascot-eye" cx="78" cy="44" r="2.6" />
    <text class="mascot-staff" x="112" y="200" font-size="168">|</text>

    <!-- the flock: six marks, gathered near the staff hand once triggered.
         x/y is each mark's true settled position; the scattered start is a
         CSS transform (global.css), removed when .is-gathered lands. -->
    <use href="#flock-mark" class="flock-mark flock-mark--1" x="88" y="48" width="20" height="20" />
    <use href="#flock-mark" class="flock-mark flock-mark--2" x="114" y="42" width="18" height="18" />
    <use href="#flock-mark" class="flock-mark flock-mark--3" x="132" y="58" width="22" height="22" />
    <use href="#flock-mark" class="flock-mark flock-mark--4" x="92" y="80" width="17" height="17" />
    <use href="#flock-mark" class="flock-mark flock-mark--5" x="118" y="84" width="19" height="19" />
    <use href="#flock-mark" class="flock-mark flock-mark--6" x="106" y="64" width="24" height="24" />
  </svg>
</div>
