---
// The shepherd mascot, copied from the reference implementation's hero SVG
// (~/Downloads/amwayi-site/index.html) rather than redrawn: leaning on his
// crook, hand on chin, eyes up, a red shuka over a green robe, one sheep
// at his feet, a thought trail leading to the bubble. The panel, hills and
// sun follow the active daisyUI theme (base-200 / --hill-1 / --hill-2 /
// --sun custom properties, src/styles/tailwind.css); the shepherd and
// sheep keep fixed colors regardless of theme, same as the reference.
---
<svg
  class="absolute inset-0 size-full"
  viewBox="0 0 600 560"
  fill="none"
  role="img"
  aria-label="A cartoon shepherd leaning on his staff, hand on chin, thinking, with a sheep at his feet"
>
  <rect width="600" height="560" rx="28" class="fill-base-200" />
  <circle cx="530" cy="92" r="38" style="fill:var(--sun)" />
  <path
    d="M0 360 C120 300 230 330 320 290 C410 250 500 270 600 230 V560 H0 Z"
    style="fill:var(--hill-1)"
  />
  <path
    d="M0 440 C150 395 280 430 390 400 C480 375 540 385 600 370 V560 H0 Z"
    style="fill:var(--hill-2)"
  />
  <path
    d="M30 548 C90 520 70 470 150 440 C230 410 250 350 330 322 C410 296 470 290 540 262"
    class="stroke-base-content"
    stroke-opacity=".35"
    stroke-width="2"
    stroke-dasharray="2 9"
    stroke-linecap="round"
  />
  <!-- sheep -->
  <g stroke="#1D2420" stroke-width="3">
    <line x1="150" y1="498" x2="150" y2="520" stroke-width="5" stroke-linecap="round" />
    <line x1="192" y1="498" x2="192" y2="520" stroke-width="5" stroke-linecap="round" />
    <circle cx="152" cy="476" r="20" fill="#fff" /><circle cx="176" cy="464" r="22" fill="#fff" /><circle
      cx="200"
      cy="476"
      r="20"
      fill="#fff"
    />
    <circle cx="164" cy="492" r="17" fill="#fff" /><circle cx="190" cy="492" r="17" fill="#fff" />
    <ellipse cx="128" cy="480" rx="13" ry="15" fill="#2A2A2A" />
    <ellipse cx="118" cy="470" rx="7" ry="4" fill="#2A2A2A" transform="rotate(-25 118 470)" />
  </g>
  <circle cx="124" cy="478" r="2.5" fill="#fff" />
  <!-- shepherd -->
  <path d="M470 520 V252 a24 24 0 0 0 -48 0 v8" stroke="#6B4423" stroke-width="7" stroke-linecap="round" />
  <rect x="372" y="452" width="14" height="62" rx="6" fill="#6E4A33" stroke="#1D2420" stroke-width="2.5" />
  <rect x="398" y="452" width="14" height="62" rx="6" fill="#6E4A33" stroke="#1D2420" stroke-width="2.5" />
  <ellipse cx="378" cy="516" rx="15" ry="6" fill="#3B2A1E" /><ellipse cx="408" cy="516" rx="15" ry="6" fill="#3B2A1E" />
  <path d="M352 332 Q390 318 428 332 L446 464 Q390 476 334 464 Z" fill="#3F5A3C" stroke="#1D2420" stroke-width="3" />
  <path d="M354 334 L380 326 L442 442 L430 462 Z" fill="#B23A2E" stroke="#1D2420" stroke-width="2.5" />
  <path d="M370 350 L388 343 M388 382 L407 374 M406 414 L425 406" stroke="#7A1F18" stroke-width="3" />
  <rect x="340" y="400" width="100" height="10" rx="4" fill="#C08A3E" stroke="#1D2420" stroke-width="2.5" />
  <rect x="381" y="312" width="16" height="16" fill="#7A4A2E" />
  <circle cx="389" cy="286" r="34" fill="#7A4A2E" stroke="#1D2420" stroke-width="3" />
  <circle cx="422" cy="291" r="6" fill="#7A4A2E" stroke="#1D2420" stroke-width="2.5" />
  <path
    d="M356 282 Q356 248 389 248 Q423 248 423 282 Q413 262 389 262 Q365 262 356 282 Z"
    fill="#1D1A17"
  />
  <ellipse cx="377" cy="289" rx="6" ry="7" fill="#fff" stroke="#1D2420" stroke-width="2.5" />
  <ellipse cx="399" cy="289" rx="6" ry="7" fill="#fff" stroke="#1D2420" stroke-width="2.5" />
  <circle cx="374" cy="286" r="3" fill="#1D2420" /><circle cx="396" cy="286" r="3" fill="#1D2420" />
  <path d="M368 277 Q376 271 384 275 M392 271 Q400 264 408 270" stroke="#1D2420" stroke-width="2.5" stroke-linecap="round" />
  <path d="M381 306 Q390 311 398 304" stroke="#1D2420" stroke-width="3" stroke-linecap="round" />
  <path
    d="M358 340 L343 374 L374 326"
    stroke="#3F5A3C"
    stroke-width="16"
    stroke-linecap="round"
    stroke-linejoin="round"
