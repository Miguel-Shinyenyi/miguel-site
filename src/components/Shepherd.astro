  <circle cx="326" cy="222" r="12" fill="#fff" stroke="#1D2420" stroke-width="3" />
  <circle cx="344" cy="248" r="8" fill="#fff" stroke="#1D2420" stroke-width="3" />
  <circle cx="357" cy="266" r="5" fill="#fff" stroke="#1D2420" stroke-width="3" />
</svg>
