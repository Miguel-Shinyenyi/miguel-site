---
import EntryMeta from './EntryMeta.astro';
import { withBase } from '../lib/url';

interface Entry {
  slug: string;
  data: {
    title: string;
    date: Date;
    summary: string;
    draft: boolean;
    updated?: Date;
  };
}

interface Props {
  entries: Entry[];
  section: string;
}
const { entries, section } = Astro.props;
---
<ul class="mt-8 flex flex-col gap-8">
  {entries.map((entry) => (
    <li class="grid gap-2 border-b border-base-300 pb-8 md:grid-cols-[130px_1fr] md:gap-8">
      <EntryMeta date={entry.data.date} draft={entry.data.draft} updated={entry.data.updated} />
      <div>
        <a href={withBase(`/${section}/${entry.slug}`)} class="font-display text-2xl font-semibold hover:text-primary">
          {entry.data.title}
        </a>
        <p class="mt-2 text-base-content/70">{entry.data.summary}</p>
      </div>
    </li>
  ))}
</ul>
