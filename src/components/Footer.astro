---
// Footer ported from the 2026-09-29 reference ("~/Downloads/amwayi-site 2",
// index.html). It is the one dark block on the site by design, so the
// simple variant inner pages used to get is gone: every page ends the
// same way, which is what the reference does.
//
// The sign-up is MailerLite's "HTML code" embed in this site's own markup
// (see docs/design.md). Its class hooks are load-bearing for
// webforms.min.js; everything visual comes from this design system.
import { getCollection } from 'astro:content';
import { resolveLink } from '../lib/url';

const [linksEntry] = await getCollection('links');
const socialLinks = linksEntry.data.links;
const year = new Date().getFullYear();
---
<footer class="bg-neutral text-neutral-content">
  <div class="mx-auto flex max-w-[1280px] flex-col gap-12 px-5 pb-8 pt-16 md:px-10 md:pt-20">
    <div class="grid gap-8 md:grid-cols-2 md:items-end md:gap-16">
      <div class="flex flex-col gap-3">
        <h2 class="text-[34px] font-bold leading-[1.05] tracking-[-0.03em] md:text-[44px]">
          Read along as I learn.
        </h2>
        <p class="text-lg text-[#B0B7AC]">One email when a new article goes out.</p>
      </div>

      <div
        id="mlb2-46272821"
        class="ml-form-embedContainer ml-subscribe-form ml-subscribe-form-46272821"
      >
        <div class="row-form">
          <form
            class="ml-block-form flex flex-col gap-2"
            action="https://assets.mailerlite.com/jsonp/2655737/forms/199417862744441907/subscribe"
            method="post"
            data-code=""
            novalidate
          >
            <label for="email" class="text-sm font-semibold text-[#D3D8CD]">Email address</label>
            <div class="flex flex-col gap-2.5 sm:flex-row">
              <div class="ml-field-group ml-field-email ml-validate-email ml-validate-required w-full">
                <input
                  id="email"
                  name="fields[email]"
                  type="email"
                  required
                  placeholder="you@example.com"
                  autocomplete="email"
                  class="field"
                  aria-describedby="email-help"
                />
              </div>
              <button type="submit" class="btn-cta shrink-0">Subscribe</button>
              <button type="button" disabled style="display: none;" class="loading btn-cta shrink-0">
                Subscribing...
              </button>
            </div>
            <input type="hidden" name="ml-submit" value="1" />
            <input type="hidden" name="anticsrf" value="true" />
            <p id="email-help" class="text-sm text-[#B0B7AC]">
              Double opt-in: confirm from the email to start receiving anything.
            </p>
            <p role="alert" class="ml-error-message text-sm font-semibold text-[#F2B3AA]">
              That email doesn't look right. Check it and try again.
            </p>
          </form>
        </div>
        <p role="status" class="row-success text-sm font-semibold text-[#B9DDB6]">
          <span class="inline-flex items-center gap-2">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12l5 5l10 -10" />
            </svg>
            Check your email to confirm, then you're on the list.
          </span>
        </p>
      </div>
    </div>

    <div class="flex flex-col-reverse gap-4 border-t border-[#2E3630] pt-6 text-sm text-[#9AA196] md:flex-row md:items-center md:justify-between">
      <span>© {year} Amwayi</span>
      <nav
        aria-label="Elsewhere"
        class="grid grid-cols-3 gap-x-6 gap-y-1 text-[15px] font-semibold text-neutral-content sm:flex"
      >
        {socialLinks.map((link) => {
          const external = !link.url.startsWith('/');
          return (
            <a
              href={resolveLink(link.url)}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
              class="py-2.5 hover:text-[#F0AE4E]"
            >
              {link.label}
            </a>
          );
        })}
      </nav>
    </div>
  </div>

  <script is:inline>
    function ml_webform_success_46272821() {
      var container = document.getElementById('mlb2-46272821');
      if (container) container.classList.add('ml-submitted');
    }
  </script>
  <script is:inline>
    fetch('https://assets.mailerlite.com/jsonp/2655737/forms/199417862744441907/takel');
  </script>
  <script is:inline src="https://groot.mailerlite.com/js/w/webforms.min.js?v83147fa8ce2d95cb73ece7f28b469519"></script>
</footer>
