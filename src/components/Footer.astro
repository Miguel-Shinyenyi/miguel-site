---
// Matched against the reference implementation's footer
// (~/Downloads/amwayi-site/index.html and article.html): the full
// subscribe footer is homepage-only there, inner pages (articles,
// projects, listings) get a reduced variant, copyright plus one
// contextual link, no subscribe form. Global (every page gets *a*
// footer), not just the homepage, since a footer that disappears
// entirely on every article would be a real regression.
//
// Social links now come from UMWAYI's site/links.md (real accounts, not
// the reference's own href="#" placeholders), synced to the `links`
// content collection by scripts/sync-content.mjs.
import { getCollection } from 'astro:content';
import { withBase, resolveLink } from '../lib/url';

interface Props {
  simple?: boolean;
  backHref?: string;
  backLabel?: string;
}
const { simple = false, backHref = withBase('/'), backLabel = 'Back to home' } = Astro.props;

const [linksEntry] = await getCollection('links');
const socialLinks = linksEntry.data.links;
---
{simple ? (
  <footer class="bg-neutral text-[#A9B0A7]">
    <div class="mx-auto flex max-w-[1440px] flex-col-reverse gap-2 px-5 py-8 text-sm md:flex-row md:items-center md:justify-between md:px-24 md:py-10 md:text-[15px]">
      <span>© 2026 Amwayi</span>
      <a href={backHref} class="py-3 text-base font-bold text-ochre-light no-underline hover:underline">{backLabel}</a>
    </div>
  </footer>
) : (
  <footer class="bg-neutral text-neutral-content">
    <div class="mx-auto flex max-w-[1440px] flex-col gap-10 px-5 pb-8 pt-16 md:gap-12 md:px-24 md:pb-12 md:pt-24">
      <div class="grid gap-8 md:grid-cols-2 md:items-end md:gap-20">
        <div class="flex flex-col gap-4 md:gap-5">
          <h2 class="text-[34px] leading-[1.08] tracking-[-0.02em] md:text-[52px]">Read along as I learn.</h2>
          <p class="text-[17px] leading-relaxed text-[#C9CEC6] md:text-[19px]">One email when a new article goes out. No noise.</p>
        </div>
        <form id="subscribe" class="flex flex-col gap-3" novalidate>
          <label for="email" class="text-sm font-bold text-[#C9CEC6] md:text-[15px]">Email address</label>
          <div class="join join-vertical w-full gap-2.5 md:join-horizontal md:gap-0">
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="you@example.com"
              autocomplete="email"
              class="input join-item input-lg w-full rounded-full border-[#F3EEE3] bg-[#F3EEE3] text-ink md:rounded-r-none"
            />
            <button class="btn btn-accent btn-lg join-item rounded-full md:rounded-l-none md:px-7">Subscribe</button>
          </div>
          <div id="subscribe-ok" role="status" class="alert alert-success hidden">Thanks. You'll get the next article.</div>
          <div id="subscribe-err" role="alert" class="alert alert-error hidden">That email doesn't look right. Check it and try again.</div>
        </form>
      </div>
      <div class="flex flex-col-reverse gap-4 border-t border-[#3A443E] pt-6 text-sm text-[#A9B0A7] md:flex-row md:items-center md:justify-between md:text-[15px]">
        <span>© 2026 Amwayi</span>
        <nav aria-label="Elsewhere" class="grid grid-cols-2 gap-x-7 gap-y-1 text-base font-bold md:flex">
          {socialLinks.map((link) => {
            const external = !link.url.startsWith('/');
            return (
              <a
                href={resolveLink(link.url)}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener' : undefined}
                class="py-3 text-ochre-light no-underline hover:underline"
              >
                {link.label}
              </a>
            );
          })}
        </nav>
      </div>
    </div>
  </footer>
)}
<script src="../scripts/subscribe.js"></script>
