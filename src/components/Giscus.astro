---
// Generated at giscus.app once Discussions was enabled and the giscus GitHub
// App was installed on this repo (see docs/feedback.md).
const GISCUS_REPO = 'Miguel-Shinyenyi/miguel-site';
const GISCUS_REPO_ID = 'R_kgDOUdY7xQ';
const GISCUS_CATEGORY = 'Announcements';
const GISCUS_CATEGORY_ID = 'DIC_kwDOUdY7xc4DGBkz';

const configured = Boolean(GISCUS_REPO_ID && GISCUS_CATEGORY_ID);
---
{configured && (
  <section class="comments" aria-label="Comments">
    <h2 class="section-label">Comments</h2>
    <script
      src="https://giscus.app/client.js"
      data-repo={GISCUS_REPO}
      data-repo-id={GISCUS_REPO_ID}
      data-category={GISCUS_CATEGORY}
      data-category-id={GISCUS_CATEGORY_ID}
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="0"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-lang="en"
      crossorigin="anonymous"
      async
    ></script>
  </section>
)}
