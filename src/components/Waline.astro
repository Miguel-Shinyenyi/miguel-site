---
// Waline server deployed to Vercel (see docs/feedback.md).
const WALINE_SERVER_URL = 'https://waline-comments-azure-zeta.vercel.app';

const configured = Boolean(WALINE_SERVER_URL);
---
{configured && (
  <section class="guest-comments" aria-label="Guest comments">
    <h2 class="section-label">Guest comments</h2>
    <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
    <div id="waline"></div>
    <script type="module" define:vars={{ serverURL: WALINE_SERVER_URL }}>
      import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';
      init({
        el: '#waline',
        serverURL,
        path: window.location.pathname,
        dark: 'auto',
        reaction: false,
      });
    </script>
  </section>
)}
