---
// Shared article template, ported from the 2026-09-29 reference
// ("~/Downloads/amwayi-site 2", article.html). Used by the
// philosophy/tech/journal [slug] pages and by projects/[slug].astro: same
// breadcrumb / illustration / On-this-page / takeaways / comments shell,
// with project-only header meta (status, category, stack) and a Links
// block instead of the article meta row and Keep reading.
import BaseLayout from '../layouts/BaseLayout.astro';
import Giscus from './Giscus.astro';
import Waline from './Waline.astro';
import ProfilePhoto from './ProfilePhoto.astro';
import { withBase, resolveLink } from '../lib/url';
import { getCollection, type CollectionEntry } from 'astro:content';

type Section = 'philosophy' | 'tech' | 'journal';
type PageKind = Section | 'projects';

interface Props {
  entry: CollectionEntry<Section> | CollectionEntry<'projects'>;
  section: PageKind;
  sectionLabel: string;
}
const { entry, section, sectionLabel } = Astro.props;
const isProject = section === 'projects';
const project = isProject ? (entry as CollectionEntry<'projects'>).data : null;

const { Content, headings } = await entry.render();
const toc = headings.filter((h) => h.depth === 2);

const fmtShort = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });

// Computed from real word count, not authored front matter, ~215 wpm.
const readTime = Math.max(1, Math.round(entry.body.split(/\s+/).filter(Boolean).length / 215));

// Keep reading: two most recent other articles across the three sections.
const others = isProject
  ? []
  : (
      await Promise.all(
        (['philosophy', 'tech', 'journal'] as Section[]).map(async (s) => {
          const items = await getCollection(s, ({ data }) => !data.draft);
          return items.map((item) => ({ item, s }));
        }),
      )
    )
      .flat()
      .filter(({ item }) => item.slug !== entry.slug)
      .sort((a, b) => b.item.data.date.valueOf() - a.item.data.date.valueOf())
      .slice(0, 2);

const sectionLabels: Record<string, string> = {
  philosophy: 'Philosophy',
  tech: 'Tech',
  journal: 'Journal',
};
---
<BaseLayout
  title={`${entry.data.title} — Amwayi`}
  description={entry.data.summary}
  readProgress
>
  <!-- ============ TITLE ============ -->
  <section class="mx-auto max-w-[1280px] px-5 pb-8 pt-8 md:px-10 md:pb-10 md:pt-14">
    <div class="flex max-w-[900px] flex-col gap-4 md:gap-5">
      <div class="breadcrumbs py-0 text-sm font-semibold text-soft" data-reveal style="--i:0">
        <ul>
          {isProject ? (
            <>
              <li><a href={withBase('/')}>Home</a></li>
              <li><a href={withBase('/projects')}>Projects</a></li>
              <li>{entry.data.title}</li>
            </>
          ) : (
            <>
              <li><a href={`${withBase('/')}#writing`}>Articles</a></li>
              <li>{sectionLabel}</li>
            </>
          )}
        </ul>
      </div>

      <h1 class="text-[38px] font-bold leading-[1.04] tracking-[-0.035em] md:text-[56px]" data-reveal style="--i:1">
        {entry.data.title}
      </h1>
      <p class="max-w-[52ch] text-lg leading-normal text-muted md:text-[22px]" data-reveal style="--i:2">
        {entry.data.summary}
      </p>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-3 pt-1" data-reveal style="--i:3">
        {project ? (
          <>
            <span
              class:list={[
                'chip font-semibold',
                project.statusVariant === 'success' ? 'border-success text-success' : 'border-[var(--field-edge)]',
              ]}
            >
              {project.status}
            </span>
            <span class="text-sm text-soft">{project.category}</span>
            <ul class="hidden gap-2 sm:flex" aria-label="Stack">
              {project.stack.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </>
        ) : (
          <>
            <span class="flex items-center gap-2.5 font-semibold">
              <ProfilePhoto size="sm" />
              Amwayi
            </span>
            <span class="font-mono text-sm text-soft">
              {fmtShort(entry.data.date)} · {readTime} min read
            </span>
            {entry.data.tags && entry.data.tags.length > 0 && (
              <ul class="hidden gap-2 sm:flex" aria-label="Topics">
                {entry.data.tags.map((tag) => <li class="chip">{tag}</li>)}
              </ul>
            )}
          </>
        )}
      </div>
    </div>
  </section>

  <!-- ============ ILLUSTRATION ============ -->
  {entry.data.illustration && (
    <figure class="mx-auto flex max-w-[1280px] flex-col gap-3 px-5 md:px-10" data-reveal style="--i:2">
      <div class="frame">
        <img
          src={withBase(`/illustrations/${entry.data.illustration}`)}
          alt={entry.data.illustrationAlt ?? ''}
          class="block h-auto w-full"
        />
      </div>
      {entry.data.illustrationAlt && (
        <figcaption class="text-sm text-soft md:text-[15px]">{entry.data.illustrationAlt}</figcaption>
      )}
    </figure>
  )}

  <!-- ============ BODY ============ -->
  <div class="mx-auto grid max-w-[1280px] grid-cols-1 gap-8 px-5 pb-16 pt-8 md:px-10 md:pb-24 md:pt-16 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-16">
    <aside class="min-w-0">
      <div class="flex flex-col gap-5 lg:sticky lg:top-28 lg:gap-8">
        {toc.length > 0 && (
          <>
            <details class="collapse collapse-arrow rounded-box border border-hairline bg-card lg:hidden">
              <summary class="collapse-title min-h-[52px] font-semibold">On this page</summary>
              <div class="collapse-content">
                <ul class="menu w-full gap-0.5 p-0 text-base" data-toc>
                  {toc.map((h) => (
                    <li><a class="toc-link rounded-lg" href={`#${h.slug}`}>{h.text}</a></li>
                  ))}
                </ul>
              </div>
            </details>

            <nav aria-label="On this page" class="hidden flex-col gap-2 lg:flex">
              <p class="px-3 text-sm font-semibold text-soft">On this page</p>
              <ul class="menu w-full gap-0.5 p-0 text-[15px]" data-toc>
                {toc.map((h) => (
                  <li><a class="toc-link min-h-10 rounded-lg" href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ul>
            </nav>
          </>
        )}

        <div class="flex items-center justify-between gap-3 lg:flex-col lg:items-start lg:justify-start">
          <div class="flex flex-col gap-2">
            <p class="hidden px-3 text-sm font-semibold text-soft lg:block">Text size</p>
            <div class="flex rounded-full border border-hairline bg-card p-1" role="radiogroup" aria-label="Text size">
              <label class="grid size-10 cursor-pointer place-items-center rounded-full font-read text-[15px] transition-colors duration-150 has-checked:bg-base-content has-checked:text-base-100 has-focus-visible:outline-2">
                <input class="sr-only" type="radio" name="size" id="size-s" />
                <span aria-hidden="true">A</span><span class="sr-only">Small text</span>
              </label>
              <label class="grid size-10 cursor-pointer place-items-center rounded-full font-read text-[19px] transition-colors duration-150 has-checked:bg-base-content has-checked:text-base-100 has-focus-visible:outline-2">
                <input class="sr-only" type="radio" name="size" id="size-m" checked />
                <span aria-hidden="true">A</span><span class="sr-only">Medium text</span>
              </label>
              <label class="grid size-10 cursor-pointer place-items-center rounded-full font-read text-[23px] transition-colors duration-150 has-checked:bg-base-content has-checked:text-base-100 has-focus-visible:outline-2">
                <input class="sr-only" type="radio" name="size" id="size-l" />
                <span aria-hidden="true">A</span><span class="sr-only">Large text</span>
              </label>
            </div>
          </div>
          <div class="flex gap-2 lg:flex-col">
            <button type="button" class="btn-quiet !min-h-11 bg-card !px-4" data-copy-link aria-label="Copy link">
              <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 15l6 -6" />
                <path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464" />
                <path d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463" />
              </svg>
              <span class="hidden lg:inline" data-copy-label>Copy link</span>
            </button>
            <button
              type="button"
              class="btn-quiet !min-h-11 hidden bg-card !px-4 aria-pressed:border-[var(--cta-edge)] aria-pressed:bg-primary aria-pressed:text-primary-content lg:inline-flex"
              data-helped
              aria-pressed="false"
            >
              <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" />
              </svg>
              <span data-helped-label>This helped</span>
            </button>
          </div>
        </div>
        <p class="hidden text-sm font-semibold text-success" role="status" data-copy-status>Link copied</p>
      </div>
    </aside>

    <article class="prose-amwayi flex min-w-0 flex-col gap-6">
      <div class="article-body"><Content /></div>

      {project && project.links && project.links.length > 0 && (
        <div class="mt-4 flex flex-col gap-3">
          <h2 class="!mt-0">Links</h2>
          <ul class="flex flex-col gap-2">
            {project.links.map((link) => {
              const external = !link.url.startsWith('/');
              return (
                <li>
                  <a
                    href={resolveLink(link.url)}
                    class="link-amber inline-flex items-center gap-1.5"
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener' : undefined}
                  >
                    {link.label}
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M17 7l-10 10" />
                      <path d="M8 7l9 0l0 9" />
                    </svg>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )}

      <button
        type="button"
        class="btn-quiet mt-2 bg-card aria-pressed:border-[var(--cta-edge)] aria-pressed:bg-primary aria-pressed:text-primary-content lg:hidden"
        data-helped
        aria-pressed="false"
      >
        <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" />
        </svg>
        <span data-helped-label>This helped</span>
      </button>

      <div class="mt-6 flex items-center gap-4 rounded-box border border-hairline bg-card p-5 md:p-6">
        <ProfilePhoto size="lg" />
        <div class="flex flex-col gap-0.5">
          <span class="font-display text-lg font-bold tracking-[-0.01em]">Written by Amwayi</span>
          <span class="text-[15px] leading-normal text-muted">
            Backend engineer in Nairobi. I write about philosophy, tech and journaling.
          </span>
        </div>
      </div>

      {!entry.data.draft && !isProject && <Giscus />}
      {!entry.data.draft && <Waline />}
    </article>
  </div>

  <!-- ============ KEEP READING ============ -->
  {others.length > 0 && (
    <section class="border-t border-hairline bg-base-200">
      <div class="mx-auto flex max-w-[1280px] flex-col gap-6 px-5 py-14 md:gap-8 md:px-10 md:py-20">
        <h2 class="text-[30px] font-bold tracking-[-0.03em] md:text-[40px]" data-reveal>Keep reading</h2>
        <div class="grid gap-4 md:grid-cols-[1.4fr_1fr]">
          {others.map(({ item, s }, i) => (
            <a
              href={withBase(`/${s}/${item.slug}`)}
              class:list={['tile group gap-3 p-6 md:p-8', i === 1 ? 'bg-[var(--amber-tint)]' : 'bg-card']}
              data-reveal
              style={`--i:${i + 1}`}
            >
              <span class="text-sm font-semibold text-soft">{sectionLabels[s]}</span>
              <span class="font-display text-2xl font-bold leading-tight tracking-[-0.02em] md:text-[28px]">
                {item.data.title}
              </span>
              <span class="mt-auto flex items-center justify-between pt-2 font-mono text-sm text-soft">
                {fmtShort(item.data.date)} · {Math.max(1, Math.round(item.body.split(/\s+/).filter(Boolean).length / 215))} min
                <span class="text-base-content transition-transform duration-150 group-hover:translate-x-1">
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12l14 0" />
                    <path d="M13 18l6 -6" />
                    <path d="M13 6l6 6" />
                  </svg>
                </span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script src="../scripts/article-controls.js"></script>
</BaseLayout>
