node_modules/
dist/
.astro/

# Content comes from UMWAYI at build time (scripts/sync-content.mjs),
# never committed here. src/content/config.ts (the schema) stays.
.umwayi/
src/content/philosophy/*.md
src/content/tech/*.md
src/content/journal/*.md
src/content/projects/*.md
src/content/now/*.md
src/content/links/*.md
public/illustrations/
public/images/
public/files/

# Analytics keys. The PostHog project key ships in client JS by design,
# but it still never gets committed. CI reads it from repository secrets.
.env
.env.*
!.env.example
